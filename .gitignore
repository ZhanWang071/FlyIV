# ==========================================
# 全局/通用忽略 (Global Ignores)
# ==========================================
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ==========================================
# Client 文件夹 (Unity Project)
# ==========================================
# 核心临时文件夹
Client/[Ll]ibrary/
Client/[Tt]emp/
Client/[Oo]bj/
Client/[Bb]uild/
Client/[Bb]uilds/
Client/[Ll]ogs/
Client/[Uu]ser[Ss]ettings/
Client/[Mm]emoryCaptures/
Client/[Rr]ecordings/

